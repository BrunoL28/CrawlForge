# ══════════════════════════════════════════════════════
# CrawlForge — Environment Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────
APP_NAME=CrawlForge
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG               # DEBUG | INFO | WARNING | ERROR
APP_HOST=0.0.0.0
APP_PORT=8000
WORKER_REPLICAS=2

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Supabase / PostgreSQL + pgvector ──────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
DATABASE_URL=postgresql://postgres:postgres@db:5432/crawlforge

# ── Embedding: OpenAI (primary) ───────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Embedding: Google (secondary/fallback) ────────────
GOOGLE_API_KEY=your-google-api-key
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# ── crawl4ai Browser Settings ─────────────────────────
CRAWL4AI_BROWSER_TYPE=chromium     # chromium | firefox | webkit
CRAWL4AI_HEADLESS=true
CRAWL4AI_VIEWPORT_WIDTH=1280
CRAWL4AI_VIEWPORT_HEIGHT=720
CRAWL4AI_TEXT_MODE=false
CRAWL4AI_LIGHT_MODE=false
CRAWL4AI_VERBOSE=false

# ── Queue Settings ────────────────────────────────────
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_BASE=2.0
QUEUE_BACKOFF_MAX=60.0
QUEUE_DEFAULT_PRIORITY=5
